<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>Rules & Regulations – NVTC</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet" />

    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

    <!-- External CSS -->
    <link rel="stylesheet" href="/style-rules.css" />
</head>
<body>

    <div class="container">

        <!-- ===== HEADER ===== -->
        <div class="header">
            <div class="logo-icon">
                <span class="logo-img"></span>
            </div>
            <h1>NVTC<span>.</span></h1>
            <p class="subtitle">Nakuru Vocational Training Centre</p>
            <p class="contact-info">P.O. Box 3973 - 20100, Nakuru | Tel: 0702 474 169</p>
            <div class="gov-badge">
                <i class="fas fa-building"></i> County Government of Nakuru
            </div>
            <h2 class="page-title"><i class="fas fa-book"></i> Rules &amp; Regulations</h2>
        </div>

        <!-- ===== BACK BUTTON ===== -->
        <div class="back-button">
            <a href="/">
                <i class="fas fa-arrow-left"></i> Back to Home
            </a>
        </div>

        <!-- ===== RULES CARD ===== -->
        <div class="rules-card">

            <div class="card-header">
                <div class="icon-ring">
                    <i class="fas fa-gavel"></i>
                </div>
                <div>
                    <h2>Vocational Rules and Regulations</h2>
                    <p>All trainees MUST observe these rules during their training period at NVTC</p>
                </div>
            </div>

            <!-- ===== RULES GRID ===== -->
            <div class="rules-grid">

                <!-- Rule 1 -->
                <div class="rule-item">
                    <span class="rule-number">01</span>
                    <span class="rule-text"><strong>Punctuality:</strong> Programs run from 8:00 AM to 5:00 PM. All trainees must observe time and be at the right place at the right time.</span>
                </div>

                <!-- Rule 2 -->
                <div class="rule-item">
                    <span class="rule-number">02</span>
                    <span class="rule-text"><strong>Dress Code:</strong> Trainees must dress as per the guidelines produced for decent dressing in the dressing code.</span>
                </div>

                <!-- Rule 3 -->
                <div class="rule-item">
                    <span class="rule-number">03</span>
                    <span class="rule-text"><strong>Respect:</strong> All trainees must behave respectfully to all Instructors, Non-Teaching staff, Visitors and the general public.</span>
                </div>

                <!-- Rule 4 -->
                <div class="rule-item">
                    <span class="rule-number">04</span>
                    <span class="rule-text"><strong>Class Attendance:</strong> All trainees must attend all classes and report at least five minutes before the start of any lesson.</span>
                </div>

                <!-- Rule 5 -->
                <div class="rule-item">
                    <span class="rule-number">05</span>
                    <span class="rule-text"><strong>Communication:</strong> All trainees are required to use the official languages — English or Kiswahili.</span>
                </div>

                <!-- Rule 6 -->
                <div class="rule-item">
                    <span class="rule-number">06</span>
                    <span class="rule-text"><strong>Hygiene:</strong> Classes/Workshops must be kept clean at all times. Trainees are responsible for maintaining general hygiene within the Institution Compound.</span>
                </div>

                <!-- Rule 7 -->
                <div class="rule-item">
                    <span class="rule-number">07</span>
                    <span class="rule-text"><strong>Care of Property:</strong> Any trainee found mishandling Institution assets leading to breakage shall incur costs for repairs or acquire a new asset.</span>
                </div>

                <!-- Rule 8 -->
                <div class="rule-item">
                    <span class="rule-number">08</span>
                    <span class="rule-text"><strong>Smoking, Alcohol &amp; Drugs:</strong> Strictly prohibited. This can lead to instant expulsion.</span>
                </div>

                <!-- Rule 9 -->
                <div class="rule-item">
                    <span class="rule-number">09</span>
                    <span class="rule-text"><strong>Mobile Phones:</strong> Not allowed in classrooms during lesson hours. Phones will be confiscated for a minimum of two weeks.</span>
                </div>

                <!-- Rule 10 -->
                <div class="rule-item">
                    <span class="rule-number">10</span>
                    <span class="rule-text"><strong>Theft:</strong> Found stealing or handling stolen property will lead to expulsion or being handed over to the police.</span>
                </div>

                <!-- Rule 11 -->
                <div class="rule-item">
                    <span class="rule-number">11</span>
                    <span class="rule-text"><strong>Fighting:</strong> Insulting, bullying, fighting or threatening members of staff or other trainees can lead to suspension or expulsion.</span>
                </div>

                <!-- Rule 12 -->
                <div class="rule-item">
                    <span class="rule-number">12</span>
                    <span class="rule-text"><strong>Leave Out:</strong> No trainee shall walk out without a leave sheet duly signed by the Principal or authorized staff.</span>
                </div>

                <!-- Rule 13 -->
                <div class="rule-item">
                    <span class="rule-number">13</span>
                    <span class="rule-text"><strong>Fees:</strong> All trainees must pay their fees in time. Failure to honor the agreement will cause the trainee to be sent home.</span>
                </div>

                <!-- Rule 14 -->
                <div class="rule-item">
                    <span class="rule-number">14</span>
                    <span class="rule-text"><strong>Trespass Pass:</strong> The institution has only one entry point. Any trainee found passing through the fence shall face instant suspension or expulsion.</span>
                </div>

                <!-- Rule 15 -->
                <div class="rule-item">
                    <span class="rule-number">15</span>
                    <span class="rule-text"><strong>Sexual Immorality:</strong> Any trainee caught in sexual advancements (kissing, caressing, sexual intercourse) shall face instant suspension or expulsion.</span>
                </div>

            </div>

            <!-- ===== READ MORE / ATTACHMENT SECTION ===== -->
            <div class="read-more-section">
                <div class="info-box">
                    <div class="info-text">
                        <i class="fas fa-file-pdf"></i>
                        <div>
                            <h3>Full Rules &amp; Regulations Document</h3>
                            <p>Download the complete rules and regulations document for all trainees and boarding rules</p>
                        </div>
                    </div>
                    <a href="/rules_and_regulations_new.docx" download="rules_and_regulations_new.docx" class="btn-download">
                        <i class="fas fa-download"></i> Download PDF
                    </a>
                </div>
            </div>

        </div>
        <!-- ===== FOOTER ===== -->
        <div class="footer">
            <p>
                <i class="fas fa-shield-alt" style="color:var(--primary);"></i>
                County Government of Nakuru – Department of Education, ICT & eGovernment
            </p>
            <p style="margin-top:4px;">
                <a href="/"><i class="fas fa-arrow-left"></i> Back to Home</a>
            </p>
        </div>
    </div>

</body>
</html>