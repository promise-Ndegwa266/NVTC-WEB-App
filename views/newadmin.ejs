<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Management – NVTC</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet" />

    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <link rel="icon" type="image/x-icon" href="/img/logo.png" />
    <style>
        *,
        *::before,
        *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary: #3050df;
            --primary-dark: #0e2983;
            --primary-light: #e6f5ed;
            --accent: #f5a623;
            --white: #ffffff;
            --gray-50: #f9fafb;
            --gray-100: #f3f4f6;
            --gray-200: #e5e7eb;
            --gray-300: #d1d5db;
            --gray-400: #9ca3af;
            --gray-500: #6b7280;
            --gray-600: #4b5563;
            --gray-700: #374151;
            --gray-800: #1f2937;
            --gray-900: #111827;
            --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            --shadow-md: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
            --shadow-lg: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            --shadow-xl: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            --radius: 12px;
            --radius-lg: 16px;
            --transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: linear-gradient(165deg, #f0f7f3 0%, #e6f5ed 30%, #d4ebe0 70%, #c5e3d4 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            margin: 0;
            position: relative;
        }

        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background:
                radial-gradient(circle at 20% 20%, rgba(10, 107, 60, 0.05) 0%, transparent 50%),
                radial-gradient(circle at 80% 80%, rgba(10, 107, 60, 0.05) 0%, transparent 50%);
            pointer-events: none;
            z-index: 0;
        }

        .container {
            width: 100%;
            max-width: 960px;
            position: relative;
            z-index: 1;
            animation: fadeInUp 0.5s ease-out;
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .brand {
            text-align: center;
            margin-bottom: 28px;
        }

        .brand .logo-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 64px;
            height: 64px;
            border-radius: 50%;
            background: var(--white);
            box-shadow: var(--shadow-lg);
            font-size: 2rem;
            color: var(--primary);
            margin-bottom: 12px;
            transition: var(--transition);
        }

        .brand .logo-icon:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-xl);
        }

        .brand h1 {
            font-size: 1.6rem;
            font-weight: 800;
            color: var(--gray-900);
            letter-spacing: -0.02em;
        }

        .brand h1 span {
            color: var(--primary);
        }

        .brand p {
            color: var(--gray-500);
            font-size: 0.85rem;
            margin-top: 2px;
        }

        .card {
            background: var(--white);
            border-radius: var(--radius-lg);
            padding: 36px 36px 32px;
            box-shadow: var(--shadow-xl);
            border: 1px solid rgba(255, 255, 255, 0.5);
            backdrop-filter: blur(8px);
        }

        .card-header {
            text-align: center;
            margin-bottom: 28px;
        }

        .card-header .header-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 56px;
            height: 56px;
            border-radius: 50%;
            background: var(--primary-light);
            color: var(--primary);
            font-size: 1.5rem;
            margin-bottom: 10px;
        }

        .card-header h2 {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--gray-900);
        }

        .card-header p {
            color: var(--gray-500);
            font-size: 0.9rem;
            margin-top: 4px;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px;
        }

        .form-group {
            margin-bottom: 18px;
        }

        .form-group label {
            display: block;
            font-weight: 600;
            font-size: 0.85rem;
            color: var(--gray-700);
            margin-bottom: 5px;
        }

        .form-group label .required {
            color: #ef4444;
            margin-left: 2px;
        }

        .input-wrapper {
            position: relative;
            display: flex;
            align-items: center;
        }

        .input-wrapper .icon {
            position: absolute;
            left: 14px;
            color: var(--gray-400);
            font-size: 1rem;
            pointer-events: none;
            z-index: 1;
            transition: var(--transition);
        }
        .input-wrapper select,
        .input-wrapper input {
            width: 100%;
            padding: 11px 14px 11px 44px;
            border: 2px solid var(--gray-200);
            border-radius: 10px;
            font-family: inherit;
            font-size: 0.95rem;
            color: var(--gray-800);
            background: var(--gray-50);
            transition: var(--transition);
            outline: none;
        }

        .input-wrapper input:focus {
            border-color: var(--primary);
            background: var(--white);
            box-shadow: 0 0 0 4px rgba(10, 107, 60, 0.1);
        }

        .input-wrapper input:focus~.icon {
            color: var(--primary);
        }

        .input-wrapper input::placeholder {
            color: var(--gray-400);
            font-size: 0.9rem;
        }

        .input-wrapper .toggle-password {
            position: absolute;
            right: 14px;
            color: var(--gray-400);
            cursor: pointer;
            font-size: 1rem;
            transition: var(--transition);
            background: none;
            border: none;
            padding: 4px;
            z-index: 1;
        }

        .input-wrapper .toggle-password:hover {
            color: var(--gray-600);
        }

        .input-wrapper.error input {
            border-color: #ef4444;
            background: #fef2f2;
        }

        .input-wrapper.error .icon {
            color: #ef4444;
        }

        .error-msg {
            font-size: 0.78rem;
            color: #ef4444;
            margin-top: 4px;
            display: none;
            align-items: center;
            gap: 4px;
        }

        .error-msg.show {
            display: flex;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 13px 28px;
            border: none;
            border-radius: 10px;
            font-family: inherit;
            font-size: 0.95rem;
            font-weight: 700;
            cursor: pointer;
            transition: var(--transition);
            text-decoration: none;
            width: 100%;
        }

        .btn-primary {
            background: var(--primary);
            color: var(--white);
            box-shadow: 0 4px 16px rgba(10, 107, 60, 0.3);
        }

        .btn-primary:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(10, 107, 60, 0.35);
        }

        .btn-primary:active {
            transform: translateY(0);
        }

        .admin-list-section {
            margin-top: 32px;
            padding-top: 28px;
            border-top: 2px solid var(--gray-100);
        }

        .list-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 16px;
        }

        .list-header h3 {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--gray-800);
        }

        .list-header h3 i {
            color: var(--primary);
            margin-right: 8px;
        }

        .admin-count {
            background: var(--primary-light);
            color: var(--primary-dark);
            padding: 4px 14px;
            border-radius: 50px;
            font-size: 0.8rem;
            font-weight: 700;
        }

        .table-wrapper {
            overflow-x: auto;
            border-radius: var(--radius);
            border: 1px solid var(--gray-200);
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.9rem;
        }

        thead {
            background: var(--gray-50);
        }

        thead th {
            padding: 12px 16px;
            text-align: left;
            font-weight: 600;
            color: var(--gray-600);
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            border-bottom: 2px solid var(--gray-200);
        }

        tbody td {
            padding: 12px 16px;
            border-bottom: 1px solid var(--gray-100);
            color: var(--gray-700);
        }

        tbody tr:hover {
            background: var(--gray-50);
        }

        tbody tr:last-child td {
            border-bottom: none;
        }

        .username-tag {
            display: inline-block;
            background: var(--primary-light);
            color: var(--primary-dark);
            padding: 2px 12px;
            border-radius: 50px;
            font-size: 0.8rem;
            font-weight: 600;
        }

        .actions {
            text-align: center;
            width: 60px;
        }

        .btn-delete {
            background: none;
            border: none;
            color: #ef4444;
            font-size: 1rem;
            cursor: pointer;
            padding: 6px 10px;
            border-radius: 6px;
            transition: var(--transition);
        }

        .btn-delete:hover {
            background: #fef2f2;
            color: #b91c1c;
            transform: scale(1.1);
        }

        .actions-col {
            text-align: center;
            width: 60px;
        }

        .empty-state {
            text-align: center;
            padding: 40px 20px;
            display: none;
        }

        .empty-state i {
            font-size: 3rem;
            color: var(--gray-300);
            margin-bottom: 12px;
        }

        .empty-state p {
            color: var(--gray-400);
            font-size: 0.95rem;
            line-height: 1.6;
        }

        .footer {
            text-align: center;
            margin-top: 24px;
            padding-top: 20px;
            border-top: 1px solid rgba(255, 255, 255, 0.3);
        }

        .footer p {
            font-size: 0.85rem;
            color: var(--gray-500);
        }

        .footer a {
            color: var(--primary);
            font-weight: 600;
            text-decoration: none;
            transition: var(--transition);
        }

        .footer a:hover {
            color: var(--primary-dark);
            text-decoration: underline;
        }

        .toast {
            position: fixed;
            bottom: 30px;
            right: 30px;
            background: var(--gray-900);
            color: var(--white);
            padding: 14px 22px;
            border-radius: 12px;
            box-shadow: var(--shadow-xl);
            font-weight: 500;
            font-size: 0.9rem;
            transform: translateY(30px);
            opacity: 0;
            visibility: hidden;
            transition: var(--transition);
            z-index: 9999;
            display: flex;
            align-items: center;
            gap: 12px;
            max-width: 400px;
        }

        .toast.show {
            transform: translateY(0);
            opacity: 1;
            visibility: visible;
        }

        .toast.success {
            background: var(--primary-dark);
        }

        .toast.error {
            background: #b91c1c;
        }

        .toast i {
            font-size: 1.1rem;
            flex-shrink: 0;
        }

        @media (max-width: 768px) {
            .form-row {
                grid-template-columns: 1fr;
                gap: 0;
            }

            .card {
                padding: 24px 18px 20px;
            }

            .brand .logo-icon {
                width: 54px;
                height: 54px;
                font-size: 1.6rem;
            }

            .brand h1 {
                font-size: 1.3rem;
            }

            .card-header h2 {
                font-size: 1.2rem;
            }

            body {
                padding: 16px;
            }

            .toast {
                left: 16px;
                right: 16px;
                bottom: 16px;
                max-width: none;
                padding: 12px 16px;
                font-size: 0.85rem;
            }

            thead th,
            tbody td {
                padding: 8px 10px;
                font-size: 0.8rem;
            }

            .username-tag {
                font-size: 0.7rem;
                padding: 2px 8px;
            }

            .btn-delete {
                font-size: 0.85rem;
                padding: 4px 8px;
            }
        }

        @media (max-width: 480px) {
            .card {
                padding: 18px 12px 16px;
            }

            .brand .logo-icon {
                width: 48px;
                height: 48px;
                font-size: 1.4rem;
            }

            .brand h1 {
                font-size: 1.1rem;
            }

            .card-header h2 {
                font-size: 1rem;
            }

            .card-header p {
                font-size: 0.8rem;
            }

            .input-wrapper input {
                font-size: 0.85rem;
                padding: 10px 12px 10px 40px;
            }

            .btn {
                font-size: 0.85rem;
                padding: 11px 20px;
            }

            .list-header h3 {
                font-size: 0.95rem;
            }

            .admin-count {
                font-size: 0.7rem;
                padding: 3px 10px;
            }
        }
    </style>
</head>
<body>

    <div class="container">

        <div class="card">

            <div class="card-header">
                <div class="header-icon">
                    <i class="fas fa-user-shield"></i>
                </div>
                <h2>Admin Management</h2>
                <p>Register new administrators and manage existing ones</p>
            </div>

            <form id="adminForm" novalidate>
                <div class="form-row">
                    <div class="form-group">
                        <label for="firstName">First Name <span class="required">*</span></label>
                        <div class="input-wrapper">
                            <input type="text" id="firstName" placeholder="Enter first name" required />
                            <span class="icon"><i class="fas fa-user"></i></span>
                        </div>
                        <div class="error-msg" id="firstNameError">Please enter first name.</div>
                    </div>

                    <div class="form-group">
                        <label for="lastName">Last Name <span class="required">*</span></label>
                        <div class="input-wrapper">
                            <input type="text" id="lastName" placeholder="Enter last name" required />
                            <span class="icon"><i class="fas fa-user"></i></span>
                        </div>
                        <div class="error-msg" id="lastNameError">Please enter last name.</div>
                    </div>
                </div>

                <div class="form-group">
                    <label for="email">Email Address <span class="required">*</span></label>
                    <div class="input-wrapper">
                        <input type="email" id="email" placeholder="admin@example.com" required />
                        <span class="icon"><i class="fas fa-envelope"></i></span>
                    </div>
                    <div class="error-msg" id="emailError">Please enter a valid email address.</div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="username">Username <span class="required">*</span></label>
                        <div class="input-wrapper">
                            <input type="text" id="username" placeholder="Choose a username" required />
                            <span class="icon"><i class="fas fa-user-tag"></i></span>
                        </div>
                        <div class="error-msg" id="usernameError">Please enter a username (min 3 characters).</div>
                    </div>

                    <div class="form-group">
                        <label for="username"> Previlage <span class="required">*</span></label>
                        <div class="input-wrapper">
                            <select id="prevlage" name="previlages" required>
                            <option value="">Select admin previlage</option>
                            <option value="MainAdmin">MainAdmin</option>
                            <option value="Admin">Admin</option>
                            <option value="H.O.D">Head of depatment</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="password">Password <span class="required">*</span></label>
                        <div class="input-wrapper">
                            <input type="password" id="password" placeholder="Min 6 characters" required />
                            <span class="icon"><i class="fas fa-lock"></i></span>
                            <button type="button" class="toggle-password" id="togglePassword">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                        <div class="error-msg" id="passwordError">Password must be at least 6 characters.</div>
                    </div>
                </div>
                <input type="text" value="<%= data %>" id="userdata" style="display: none;">
                <button type="submit" class="btn btn-primary" id="submitBtn">
                    <i class="fas fa-plus-circle"></i> Register Admin
                </button>
            </form>

            <div class="admin-list-section">
                <div class="list-header">
                    <h3><i class="fas fa-users"></i> Registered Admins</h3>
                    <span class="admin-count"><%= dataAdmin.length %> admins</span>
                </div>

                <div class="table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th>First Name</th>
                                <th>Last Name</th>
                                <th>Email</th>
                                <th>Username</th>
                                <th class="actions-col">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% dataAdmin.forEach((element)=>{ %>
                                <tr>
                                    <td><%= element.name.firstName %></td>
                                    <td><%= element.name.secondName %></td>
                                    <td><%= element.email %></td>
                                    <td><span class="username-tag"><%= element.userName %></span></td>
                                    <td class="actions">
                                        <a href="/admin-dashboad/delede-admin/<%= element._id %>/<%= data %>">
                                            <button class="btn-delete" title="Delete admin">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </a>
                                        
                                    </td>
                                </tr>
                            <%}) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="footer">
            <p>
                <i class="fas fa-shield-alt" style="color:var(--primary);"></i>
                Secure Admin Management
            </p>
            <p style="margin-top:4px;">
                <a href="/admin-dashboad/admin-logout/<%= data %>"><i class="fas fa-arrow-left"></i> Back to Home</a>
            </p>
        </div>
    </div>

    <div class="toast" id="toast">
        <i class="fas fa-check-circle"></i>
        <span id="toastMsg">Redirecting to dashboard...</span>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {

            const form = document.getElementById('adminForm');
            const firstName = document.getElementById('firstName');
            const lastName = document.getElementById('lastName');
            const email = document.getElementById('email');
            const username = document.getElementById('username');
            const privlage = document.getElementById('prevlage');
            const password = document.getElementById('password');
            const userdata = document.getElementById('userdata')
            const togglePassword = document.getElementById('togglePassword');
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toastMsg');

            const firstNameError = document.getElementById('firstNameError');
            const lastNameError = document.getElementById('lastNameError');
            const emailError = document.getElementById('emailError');
            const usernameError = document.getElementById('usernameError');
            const passwordError = document.getElementById('passwordError');

            let toastTimeout;

            function isValidEmail(value) {
                return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
            }

            function showError(errorEl, msg) {
                errorEl.textContent = msg;
                errorEl.classList.add('show');
                const wrapper = errorEl.closest('.form-group').querySelector('.input-wrapper');
                if (wrapper) wrapper.classList.add('error');
            }

            function clearError(errorEl) {
                errorEl.classList.remove('show');
                const wrapper = errorEl.closest('.form-group').querySelector('.input-wrapper');
                if (wrapper) wrapper.classList.remove('error');
            }

            function clearAllErrors() {
                [firstNameError, lastNameError, emailError, usernameError, passwordError].forEach(function(el) {
                    el.classList.remove('show');
                    const wrapper = el.closest('.form-group').querySelector('.input-wrapper');
                    if (wrapper) wrapper.classList.remove('error');
                });
            }

            function showToast(message, type) {
                toastMsg.textContent = message;
                toast.className = 'toast';
                if (type === 'success') {
                    toast.classList.add('success');
                    toast.querySelector('i').className = 'fas fa-check-circle';
                } else if (type === 'error') {
                    toast.classList.add('error');
                    toast.querySelector('i').className = 'fas fa-exclamation-circle';
                } else {
                    toast.querySelector('i').className = 'fas fa-info-circle';
                }
                toast.classList.add('show');
                clearTimeout(toastTimeout);
                toastTimeout = setTimeout(function() {
                    toast.classList.remove('show');
                }, 2000);
            }

            let passwordVisible = false;
            togglePassword.addEventListener('click', function() {
                passwordVisible = !passwordVisible;
                password.type = passwordVisible ? 'text' : 'password';
                this.querySelector('i').className = passwordVisible ? 'fas fa-eye-slash' : 'fas fa-eye';
            });

            firstName.addEventListener('blur', function() {
                if (!this.value.trim()) {
                    showError(firstNameError, 'First name is required.');
                } else {
                    clearError(firstNameError);
                }
            });
            firstName.addEventListener('input', function() {
                if (this.value.trim()) clearError(firstNameError);
            });

            lastName.addEventListener('blur', function() {
                if (!this.value.trim()) {
                    showError(lastNameError, 'Last name is required.');
                } else {
                    clearError(lastNameError);
                }
            });
            lastName.addEventListener('input', function() {
                if (this.value.trim()) clearError(lastNameError);
            });

            email.addEventListener('blur', function() {
                const val = this.value.trim();
                if (!val) {
                    showError(emailError, 'Email address is required.');
                } else if (!isValidEmail(val)) {
                    showError(emailError, 'Please enter a valid email address.');
                } else {
                    clearError(emailError);
                }
            });
            email.addEventListener('input', function() {
                const val = this.value.trim();
                if (val && isValidEmail(val)) clearError(emailError);
                else if (!val) clearError(emailError);
            });

            username.addEventListener('blur', function() {
                const val = this.value.trim();
                if (!val) {
                    showError(usernameError, 'Username is required.');
                } else if (val.length < 3) {
                    showError(usernameError, 'Username must be at least 3 characters.');
                } else {
                    clearError(usernameError);
                }
            });
            username.addEventListener('input', function() {
                const val = this.value.trim();
                if (val && val.length >= 3) clearError(usernameError);
                else if (!val) clearError(usernameError);
            });

            password.addEventListener('blur', function() {
                const val = this.value;
                if (!val) {
                    showError(passwordError, 'Password is required.');
                } else if (val.length < 6) {
                    showError(passwordError, 'Password must be at least 6 characters.');
                } else {
                    clearError(passwordError);
                }
            });
            password.addEventListener('input', function() {
                const val = this.value;
                if (val && val.length >= 6) clearError(passwordError);
                else if (!val) clearError(passwordError);
            });

            form.addEventListener('submit', function(e) {
                e.preventDefault();
                clearAllErrors();

                let valid = true;

                const fName = firstName.value.trim();
                if (!fName) {
                    showError(firstNameError, 'First name is required.');
                    valid = false;
                }

                const lName = lastName.value.trim();
                if (!lName) {
                    showError(lastNameError, 'Last name is required.');
                    valid = false;
                }

                const emailVal = email.value.trim();
                if (!emailVal) {
                    showError(emailError, 'Email address is required.');
                    valid = false;
                } else if (!isValidEmail(emailVal)) {
                    showError(emailError, 'Please enter a valid email address.');
                    valid = false;
                }

                const userVal = username.value.trim();
                if (!userVal) {
                    showError(usernameError, 'Username is required.');
                    valid = false;
                } else if (userVal.length < 3) {
                    showError(usernameError, 'Username must be at least 3 characters.');
                    valid = false;
                }

                const passVal = password.value;
                if (!passVal) {
                    showError(passwordError, 'Password is required.');
                    valid = false;
                } else if (passVal.length < 6) {
                    showError(passwordError, 'Password must be at least 6 characters.');
                    valid = false;
                }

                if (!valid) {
                    showToast('Please fix the errors above.', 'error');
                    return;
                }

                showToast('✅ Admin registered! Redirecting to dashboard...', 'success');

                setTimeout(function() {
                    const admin = {
                        name:{
                            firstName:firstName.value,
                            secondName:lastName.value 
                        },
                        email:email.value,
                        userName:username.value,
                        previlage:privlage.value,
                        password:password.value,
                        data:userdata.value
                        }
                        const admindata = JSON.stringify(admin)

                        window.location.href = `/admin-dashboad/upload-admin?admin=${admindata}`;
                    }, 1000);
            });

            document.querySelectorAll('.btn-delete').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    if (confirm('Are you sure you want to delete this admin?')) {
                        showToast('Admin deleted successfully.', 'success');
                        setTimeout(function() {
                            const admin = {
                                name:{
                                    firstName:firstName.value,
                                    secondName:lastName.value 
                                },
                                email:email.value,
                                userName:username.value,
                                previlage:privlage.value,
                                password:password.value,
                                data:userdata.value
                                }
                                const admindata = JSON.stringify(admin)

                                window.location.href = `/admin-dashboad/upload-admin?admin=${admindata}`;
                            }, 1000);
                    }
                });
            });

        });
    </script>

</body>
</html>
