                    <div class="result-header">
                        <h4><i class="fa-solid fa-recycle" style="color:#7c3aed;"></i> Environment General</h4>
                    </div>
                    <% environment.forEach((element)=>{ %>
                        <div class="result-item">
                            <span class="ri-name"><%= element.name.presidentName %></span>
                            <div class="ri-bar"><div class="ri-fill" style="width:<%= ((element.votes/studentlength)*100).toFixed(2) %>%;"></div></div>
                            <span class="ri-percent"><%= ((element.votes/studentlength)*100).toFixed(2) %> %</span>
                            <span class="ri-votes"><%= element.votes %></span>
                        </div>
                    <% }) %>
                </div>

                <!-- Environment Vice General -->
                <div class="result-card">
                    <div class="result-header">
                        <h4><i class="fa-solid fa-recycle" style="color:#7c3aed;"></i> Environment Vice General</h4>
                    </div>
