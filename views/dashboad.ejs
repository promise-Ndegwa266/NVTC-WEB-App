        <!-- ============================================================ -->
        <!-- SECTION: STUDENT DORM BOOKING SECTION                        -->
        <!-- ============================================================ -->
        <section class="section" id="Students-Dorms">

            <!-- ===== STATS ===== -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-number"><%= dormRequests.length %></div>
                    <div class="stat-label">Total Requests</div>
                    <div class="stat-change"><i class="fas fa-clipboard-list"></i></div>
                </div>
                <div class="stat-card">
                    <div class="stat-number"><%= dormRequests.filter(r => (r.status || 'Pending') === 'Pending').length %></div>
                    <div class="stat-label">Pending</div>
                    <div class="stat-change" style="background:#fef3c7;color:#d97706;">
                        <i class="fas fa-clock"></i> Awaiting
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-number"><%= dormRequests.filter(r => r.status === 'Approved').length %></div>
                    <div class="stat-label">Approved</div>
                    <div class="stat-change" style="background:#dcfce7;color:#059669;">
                        <i class="fas fa-check-circle"></i> Allocated
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-number"><%= dormRequests.filter(r => r.status === 'Denied').length %></div>
                    <div class="stat-label">Denied</div>
                    <div class="stat-change" style="background:#fee2e2;color:#dc2626;">
                        <i class="fas fa-times-circle"></i> Rejected
                    </div>
                </div>
            </div>

            <!-- ===== FILTER TABS ===== -->
            <div class="dorm-filter-tabs">
                <button class="dorm-filter-tab active" onclick="filterDormRequests('all', this)">
                    <i class="fas fa-list"></i> All
                    <span class="filter-count"><%= dormRequests.length %></span>
                </button>
                <button class="dorm-filter-tab" onclick="filterDormRequests('Pending', this)">
                    <i class="fas fa-clock"></i> Pending
                    <span class="filter-count"><%= dormRequests.filter(r => (r.status || 'Pending') === 'Pending').length %></span>
                </button>
                <button class="dorm-filter-tab" onclick="filterDormRequests('Approved', this)">
                    <i class="fas fa-check-circle"></i> Approved
                    <span class="filter-count"><%= dormRequests.filter(r => r.status === 'Approved').length %></span>
                </button>
                <button class="dorm-filter-tab" onclick="filterDormRequests('Denied', this)">
                    <i class="fas fa-times-circle"></i> Denied
                    <span class="filter-count"><%= dormRequests.filter(r => r.status === 'Denied').length %></span>
                </button>
            </div>

            <!-- ===== TABLE ===== -->
            <div class="panel">
                <div class="panel-title">
                    <i class="fas fa-bed"></i> Dorm Booking Requests
                    <span class="subtitle"><%= dormRequests.length %> total requests</span>
                </div>

                <div class="table-container">
                    <div class="table-wrapper">
                        <table class="tbl-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Student Name</th>
                                    <th>Admission No.</th>
                                    <th>Dorm Block</th>
                                    <th>Room Type</th>
                                    <th>Move In</th>
                                    <th>Move Out</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (dormRequests.length > 0) { %>
                                    <% dormRequests.forEach((req, index) => { %>
                                        <tr class="dorm-row" data-status="<%= req.status || 'Pending' %>">
                                            <td><%= index + 1 %></td>
                                            <td>
                                                <div class="dorm-student-cell">
                                                    <div class="dorm-avatar">
                                                        <%= req.studentName ? req.studentName.charAt(0).toUpperCase() : '?' %>
                                                    </div>
                                                    <div class="dorm-student-detail">
                                                        <strong><%= req.studentName || 'Unknown' %></strong>
                                                        <span>Adm: <%= req.admissionNo || '—' %></span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td><span class="dorm-tag"><%= req.admissionNo || '—' %></span></td>
                                            <td><%= req.dormBlock || '—' %></td>
                                            <td>
                                                <span class="dorm-tag">
                                                    <i class="fas fa-door-closed"></i> <%= req.roomType || '—' %>
                                                </span>
                                            </td>
                                            <td>
                                                <%= req.moveInDate ? new Date(req.moveInDate).toDateString() : '—' %>
                                            </td>
                                            <td>
                                                <%= req.moveOutDate ? new Date(req.moveOutDate).toDateString() : '—' %>
                                            </td>
                                            <td>
                                                <% if ((req.status || 'Pending') === 'Pending') { %>
                                                    <span class="dorm-status pending">
                                                        <i class="fas fa-clock"></i> Pending
                                                    </span>
                                                <% } else if (req.status === 'Approved') { %>
                                                    <span class="dorm-status approved">
                                                        <i class="fas fa-check-circle"></i> Approved
                                                    </span>
                                                <% } else { %>
                                                    <span class="dorm-status denied">
                                                        <i class="fas fa-times-circle"></i> Denied
                                                    </span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <div class="dorm-actions">
                                                    <% if ((req.status || 'Pending') === 'Pending') { %>
                                                        <a href="/admin-dashboad/approve-dorm/<%= req._id %>/<%= user %>"
                                                        onclick="return confirm('Approve dorm booking for <%= req.studentName %>?');"
                                                        class="dorm-btn approve" title="Approve">
                                                            <i class="fas fa-check"></i> Approve
                                                        </a>
                                                        <a href="/admin-dashboad/deny-dorm/<%= req._id %>/<%= user %>"
                                                        onclick="return confirm('Deny dorm booking for <%= req.studentName %>?');"
                                                        class="dorm-btn deny" title="Deny">
                                                            <i class="fas fa-times"></i> Deny
                                                        </a>
                                                    <% } else if (req.status === 'Approved') { %>
                                                        <a href="/admin-dashboad/revoke-dorm/<%= req._id %>/<%= user %>"
                                                        onclick="return confirm('Revoke approval?');"
                                                        class="dorm-btn revoke" title="Revoke">
                                                            <i class="fas fa-undo"></i> Revoke
                                                        </a>
                                                    <% } else { %>
                                                        <a href="/admin-dashboad/approve-dorm/<%= req._id %>/<%= user %>"
                                                        onclick="return confirm('Re-approve this request?');"
                                                        class="dorm-btn approve" title="Re-approve">
                                                            <i class="fas fa-redo"></i> Re-approve
                                                        </a>
                                                    <% } %>
                                                    <a href="/admin-dashboad/delete-dorm/<%= req._id %>/<%= user %>"
                                                    onclick="return confirm('Delete this request permanently?');"
                                                    class="dorm-btn delete" title="Delete">
                                                        <i class="fas fa-trash-alt"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="9">
                                            <div class="dorm-empty-state">
                                                <i class="fas fa-inbox"></i>
                                                <h4>No Dorm Booking Requests</h4>
                                                <p>There are currently no dorm booking requests from students.</p>
                                            </div>
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div style="margin-top:14px;display:flex;gap:12px;flex-wrap:wrap;font-size:12px;color:var(--text-light);">
                    <span><i class="fas fa-info-circle"></i> Approving a request allocates the dorm to the student.</span>
                    <span style="margin-left:auto;"><i class="fas fa-clock"></i> <%= time %></span>
                </div>
            </div>

        </section>

        <!-- ============================================================ -->
        <!-- SECTION: STUDENT DEFER REQUESTS                              -->
        <!-- ============================================================ -->
        <section class="section" id="Students-Differ">

            <!-- ===== STATS ===== -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-number"><%= (typeof deferRequests !== 'undefined' && deferRequests) ? deferRequests.length : 0 %></div>
                    <div class="stat-label">Total Defer Requests</div>
                    <div class="stat-change"><i class="fas fa-hourglass-half"></i></div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">
                        <%= (typeof deferRequests !== 'undefined' && deferRequests) ? deferRequests.filter(r => (r.status || 'Pending') === 'Pending').length : 0 %>
                    </div>
                    <div class="stat-label">Pending</div>
                    <div class="stat-change" style="background:#fef3c7;color:#d97706;">
                        <i class="fas fa-clock"></i> Awaiting
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">
                        <%= (typeof deferRequests !== 'undefined' && deferRequests) ? deferRequests.filter(r => r.status === 'Approved').length : 0 %>
                    </div>
                    <div class="stat-label">Approved</div>
                    <div class="stat-change" style="background:#dcfce7;color:#059669;">
                        <i class="fas fa-check-circle"></i> Granted
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">
                        <%= (typeof deferRequests !== 'undefined' && deferRequests) ? deferRequests.filter(r => r.status === 'Denied').length : 0 %>
                    </div>
                    <div class="stat-label">Denied</div>
                    <div class="stat-change" style="background:#fee2e2;color:#dc2626;">
                        <i class="fas fa-times-circle"></i> Rejected
                    </div>
                </div>
            </div>

            <!-- ===== FILTER TABS ===== -->
            <div class="dorm-filter-tabs">
                <button class="dorm-filter-tab active" onclick="filterDeferRequests('all', this)">
                    <i class="fas fa-list"></i> All
                    <span class="filter-count"><%= (typeof deferRequests !== 'undefined' && deferRequests) ? deferRequests.length : 0 %></span>
                </button>
                <button class="dorm-filter-tab" onclick="filterDeferRequests('Pending', this)">
                    <i class="fas fa-clock"></i> Pending
                    <span class="filter-count"><%= (typeof deferRequests !== 'undefined' && deferRequests) ? deferRequests.filter(r => (r.status || 'Pending') === 'Pending').length : 0 %></span>
                </button>
                <button class="dorm-filter-tab" onclick="filterDeferRequests('Approved', this)">
                    <i class="fas fa-check-circle"></i> Approved
                    <span class="filter-count"><%= (typeof deferRequests !== 'undefined' && deferRequests) ? deferRequests.filter(r => r.status === 'Approved').length : 0 %></span>
                </button>
                <button class="dorm-filter-tab" onclick="filterDeferRequests('Denied', this)">
                    <i class="fas fa-times-circle"></i> Denied
                    <span class="filter-count"><%= (typeof deferRequests !== 'undefined' && deferRequests) ? deferRequests.filter(r => r.status === 'Denied').length : 0 %></span>
                </button>
            </div>

            <!-- ===== TABLE ===== -->
            <div class="panel">
                <div class="panel-title">
                    <i class="fas fa-hourglass-half"></i> Defer Requests
                    <span class="subtitle"><%= (typeof deferRequests !== 'undefined' && deferRequests) ? deferRequests.length : 0 %> total requests</span>
                </div>

                <div class="table-container">
                    <div class="table-wrapper">
                        <table class="tbl-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Student Name</th>
                                    <th>Admission No.</th>
                                    <th>Duration</th>
                                    <th>Reason</th>
                                    <th>Start Date</th>
                                    <th>Return Date</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (typeof deferRequests !== 'undefined' && deferRequests && deferRequests.length > 0) { %>
                                    <% deferRequests.forEach((req, index) => { %>
                                        <tr class="defer-row" data-status="<%= req.status || 'Pending' %>">
                                            <td><%= index + 1 %></td>
                                            <td>
                                                <div class="dorm-student-cell">
                                                    <div class="dorm-avatar">
                                                        <%= req.studentName ? req.studentName.charAt(0).toUpperCase() : '?' %>
                                                    </div>
                                                    <div class="dorm-student-detail">
                                                        <strong><%= req.studentName || 'Unknown' %></strong>
                                                        <span>Adm: <%= req.admissionNo || '—' %></span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td><span class="dorm-tag"><%= req.admissionNo || '—' %></span></td>
                                            <td>
                                                <span class="dorm-tag">
                                                    <i class="fas fa-calendar-alt"></i> <%= req.duration || '—' %>
                                                </span>
                                            </td>
                                            <td>
                                                <span style="font-size:12px;color:var(--text-light);">
                                                    <%= req.reason || '—' %>
                                                </span>
                                            </td>
                                            <td>
                                                <%= req.startDate ? new Date(req.startDate).toDateString() : '—' %>
                                            </td>
                                            <td>
                                                <%= req.endDate ? new Date(req.endDate).toDateString() : '—' %>
                                            </td>
                                            <td>
                                                <% if ((req.status || 'Pending') === 'Pending') { %>
                                                    <span class="dorm-status pending">
                                                        <i class="fas fa-clock"></i> Pending
                                                    </span>
                                                <% } else if (req.status === 'Approved') { %>
                                                    <span class="dorm-status approved">
                                                        <i class="fas fa-check-circle"></i> Approved
                                                    </span>
                                                <% } else { %>
                                                    <span class="dorm-status denied">
                                                        <i class="fas fa-times-circle"></i> Denied
                                                    </span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <div class="dorm-actions">
                                                    <% if ((req.status || 'Pending') === 'Pending') { %>
                                                        <a href="/admin-dashboad/approve-defer/<%= req._id %>/<%= user %>"
                                                        onclick="return confirm('Approve defer request for <%= req.studentName %>?');"
                                                        class="dorm-btn approve" title="Approve">
                                                            <i class="fas fa-check"></i> Approve
                                                        </a>
                                                        <a href="/admin-dashboad/deny-defer/<%= req._id %>/<%= user %>"
                                                        onclick="return confirm('Deny defer request for <%= req.studentName %>?');"
                                                        class="dorm-btn deny" title="Deny">
                                                            <i class="fas fa-times"></i> Deny
                                                        </a>
                                                    <% } else if (req.status === 'Approved') { %>
                                                        <a href="/admin-dashboad/revoke-defer/<%= req._id %>/<%= user %>"
                                                        onclick="return confirm('Revoke approval? The request will go back to Pending.');"
                                                        class="dorm-btn revoke" title="Revoke">
                                                            <i class="fas fa-undo"></i> Revoke
                                                        </a>
                                                    <% } else { %>
                                                        <a href="/admin-dashboad/approve-defer/<%= req._id %>/<%= user %>"
                                                        onclick="return confirm('Re-approve this request?');"
                                                        class="dorm-btn approve" title="Re-approve">
                                                            <i class="fas fa-redo"></i> Re-approve
                                                        </a>
                                                    <% } %>
                                                    <a href="/admin-dashboad/delete-defer/<%= req._id %>/<%= user %>"
                                                    onclick="return confirm('Delete this defer request permanently?');"
                                                    class="dorm-btn delete" title="Delete">
                                                        <i class="fas fa-trash-alt"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="9">
                                            <div class="dorm-empty-state">
                                                <i class="fas fa-hourglass-half"></i>
                                                <h4>No Defer Requests</h4>
                                                <p>There are currently no defer requests from students.</p>
                                            </div>
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div style="margin-top:14px;display:flex;gap:12px;flex-wrap:wrap;font-size:12px;color:var(--text-light);">
                    <span><i class="fas fa-info-circle"></i> Approving a defer request allows the student to pause their studies for the requested period.</span>
                    <span style="margin-left:auto;"><i class="fas fa-clock"></i> <%= time %></span>
                </div>
            </div>

        </section>

        <!-- ============================================================ -->
        <!-- SECTION: MEMO                                                 -->
        <!-- ============================================================ -->
        <section class="section" id="Memo">

            <!-- ===== MEMO STATS ===== -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-number"><%= memos.length %></div>
                    <div class="stat-label">Total Memos</div>
                    <div class="stat-change"><i class="fas fa-envelope-open-text"></i></div>
                </div>
                <div class="stat-card">
                    <div class="stat-number"><%= memos.filter(m => m.senderName === name).length %></div>
                    <div class="stat-label">Sent by You</div>
                    <div class="stat-change" style="background:#dbeafe;color:#2563eb;">
                        <i class="fas fa-paper-plane"></i> Sent
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-number"><%= memos.filter(m => m.senderName !== name && !m.readBy.includes(name)).length %></div>
                    <div class="stat-label">Unread</div>
                    <div class="stat-change" style="background:#fee2e2;color:#dc2626;">
                        <i class="fas fa-circle"></i> New
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-number"><%= memos.filter(m => m.priority === 'Urgent').length %></div>
                    <div class="stat-label">Urgent</div>
                    <div class="stat-change" style="background:#fef3c7;color:#d97706;">
                        <i class="fas fa-exclamation-triangle"></i> Attention
                    </div>
                </div>
            </div>

            <!-- ===== SEND MEMO FORM ===== -->
            <div class="panel">
                <div class="panel-title">
                    <i class="fas fa-pen-to-square"></i> Compose New Memo
                    <span class="subtitle">Send a memo to admins and/or students</span>
                </div>

                <form action="/admin-dashboad/send-memo" method="post" onsubmit="return confirm('Send this memo?');">
                    <div class="form-grid">
                        <div class="form-group" style="grid-column: 1 / -1;">
                            <label><i class="fas fa-heading"></i> Subject <span class="required">*</span></label>
                            <input type="text" name="subject" placeholder="e.g. End of Term Examination Schedule" required maxlength="150" />
                        </div>

                        <div class="form-group">
                            <label><i class="fas fa-users"></i> Recipients <span class="required">*</span></label>
                            <select name="recipients" required>
                                <option value="">Select recipients...</option>
                                <option value="Both">Both Admins &amp; Students</option>
                                <option value="Admins">Admins Only</option>
                                <option value="Students">Students Only</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label><i class="fas fa-exclamation-triangle"></i> Priority</label>
                            <select name="priority">
                                <option value="Normal">Normal</option>
                                <option value="Important">Important</option>
                                <option value="Urgent">Urgent</option>
                            </select>
                        </div>

                        <div class="form-group" style="grid-column: 1 / -1;">
                            <label><i class="fas fa-message"></i> Memo Message <span class="required">*</span></label>
                            <textarea name="message" rows="6"
                                    placeholder="Type your memo message here..."
                                    required maxlength="2000"
                                    style="width:100%;padding:12px;border-radius:10px;border:2px solid #e5e7eb;font-family:inherit;font-size:13px;resize:vertical;outline:none;"></textarea>
                            <div class="helper">Maximum 2000 characters</div>
                        </div>

                        <input style="display:none;" type="text" name="id" value="<%= user %>">
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-accent">
                            <i class="fas fa-paper-plane"></i> Send Memo
                        </button>
                        <button type="reset" class="btn btn-outline">
                            <i class="fas fa-undo"></i> Clear
                        </button>
                    </div>
                </form>
            </div>

            <!-- ===== FILTER TABS ===== -->
            <div class="memo-filter-tabs">
                <button class="memo-filter-tab active" onclick="filterMemos('all', this)">
                    <i class="fas fa-list"></i> All Memos
                    <span class="filter-count"><%= memos.length %></span>
                </button>
                <button class="memo-filter-tab" onclick="filterMemos('inbox', this)">
                    <i class="fas fa-inbox"></i> Inbox
                    <span class="filter-count"><%= memos.filter(m => m.senderName !== name).length %></span>
                </button>
                <button class="memo-filter-tab" onclick="filterMemos('sent', this)">
                    <i class="fas fa-paper-plane"></i> Sent
                    <span class="filter-count"><%= memos.filter(m => m.senderName === name).length %></span>
                </button>
                <button class="memo-filter-tab" onclick="filterMemos('urgent', this)">
                    <i class="fas fa-exclamation-triangle"></i> Urgent
                    <span class="filter-count"><%= memos.filter(m => m.priority === 'Urgent').length %></span>
                </button>
            </div>

            <!-- ===== MEMO LIST ===== -->
            <div class="panel">
                <div class="panel-title">
                    <i class="fas fa-envelope-open-text"></i> Memo Board
                    <span class="subtitle"><%= memos.length %> memos</span>
                </div>

                <div class="memo-list">
                    <% if (memos.length > 0) { %>
                        <% memos.forEach((memo) => { %>
                            <%
                                const isOwn = memo.senderName === name;
                                const isUnread = !isOwn && !memo.readBy.includes(name);
                                const priorityClass = memo.priority === 'Urgent' ? 'urgent'
                                                    : memo.priority === 'Important' ? 'important'
                                                    : 'normal';
                            %>
                            <div class="memo-card <%= priorityClass %> <%= isUnread ? 'unread' : '' %>"
                                data-owner="<%= isOwn ? 'sent' : 'inbox' %>"
                                data-priority="<%= memo.priority %>">

                                <div class="memo-card-header">
                                    <div class="memo-header-left">
                                        <div class="memo-sender-avatar">
                                            <%= memo.senderName.charAt(0).toUpperCase() %>
                                        </div>
                                        <div class="memo-sender-info">
                                            <div class="memo-subject">
                                                <% if (memo.priority === 'Urgent') { %>
                                                    <i class="fas fa-exclamation-triangle" style="color:#dc2626;"></i>
                                                <% } else if (memo.priority === 'Important') { %>
                                                    <i class="fas fa-exclamation-circle" style="color:#d97706;"></i>
                                                <% } %>
                                                <%= memo.subject %>
                                            </div>
                                            <div class="memo-meta">
                                                <span><i class="fas fa-user"></i> <%= memo.senderName %></span>
                                                <span>•</span>
                                                <span><i class="fas fa-user-tag"></i> <%= memo.senderRole %></span>
                                                <span>•</span>
                                                <span><i class="fas fa-users"></i> To: <%= memo.recipients %></span>
                                                <span>•</span>
                                                <span><i class="fas fa-calendar"></i> <%= new Date(memo.createdAt).toDateString() %></span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="memo-header-right">
                                        <% if (memo.priority === 'Urgent') { %>
                                            <span class="memo-priority urgent">
                                                <i class="fas fa-exclamation-triangle"></i> Urgent
                                            </span>
                                        <% } else if (memo.priority === 'Important') { %>
                                            <span class="memo-priority important">
                                                <i class="fas fa-exclamation-circle"></i> Important
                                            </span>
                                        <% } else { %>
                                            <span class="memo-priority normal">
                                                <i class="fas fa-info-circle"></i> Normal
                                            </span>
                                        <% } %>

                                        <% if (isUnread) { %>
                                            <span class="memo-new-badge">NEW</span>
                                        <% } %>
                                    </div>
                                </div>

                                <div class="memo-body">
                                    <%= memo.message %>
                                </div>

                                <div class="memo-card-footer">
                                    <div class="memo-actions">
                                        <% if (!isOwn && isUnread) { %>
                                            <a href="/admin-dashboad/read-memo/<%= memo._id %>/<%= user %>"
                                            class="memo-btn mark-read">
                                                <i class="fas fa-check"></i> Mark as Read
                                            </a>
                                        <% } %>
                                        <% if (isOwn) { %>
                                            <a href="/admin-dashboad/delete-memo/<%= memo._id %>/<%= user %>"
                                            onclick="return confirm('Delete this memo permanently?');"
                                            class="memo-btn delete">
                                                <i class="fas fa-trash-alt"></i> Delete
                                            </a>
                                        <% } %>
                                    </div>
                                    <div class="memo-recipients-info">
                                        <i class="fas fa-eye"></i> Read by <%= memo.readBy.length %> admin(s)
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="memo-empty-state">
                            <i class="fas fa-envelope-open"></i>
                            <h4>No Memos Yet</h4>
                            <p>Start by composing your first memo above.</p>
                        </div>
                    <% } %>
                </div>
            </div>

        </section>

        <!-- ============================================================ -->
        <!-- SECTION: ADMIN PROFILE                                       -->
        <!-- ============================================================ -->
        <section class="section" id="Admin">

            <!-- ===== PROFILE HEADER ===== -->
            <div class="profile-header-card">
                <div class="profile-cover">
                    <img src="/img/images.jpg" alt="NVTC Campus Cover" />
                    <label class="cover-upload-btn">
                        <i class="fas fa-camera"></i> Change Cover
                        <input type="file" accept="image/*" />
                    </label>
                </div>

                <div class="profile-body">
                    <div class="profile-avatar-wrapper">
                        <div class="profile-avatar-large">
                            <img src="/img/logo.png" alt="Admin" />
                        </div>
                        <label class="avatar-upload-btn" title="Change profile picture">
                            <i class="fas fa-camera"></i>
                            <input type="file" accept="image/*" />
                        </label>
                    </div>

                    <div class="profile-meta">
                        <div class="profile-name-block">
                            <h1><%= name %></h1>
                            <p><i class="fas fa-envelope"></i> <%= Admininfo.email || 'admin@nvct.ac.ke' %> &nbsp;•&nbsp; <i class="fas fa-phone"></i> <%= Admininfo.phone || '0702 474 169' %></p>
                            <div class="role-badges">
                                <span class="role-badge super-admin">
                                    <i class="fas fa-crown"></i> <%= Admininfo.prevlage || 'Admin' %>
                                </span>
                                <span class="role-badge verified">
                                    <i class="fas fa-check-circle"></i> Verified
                                </span>
                            </div>
                        </div>

                        <div class="profile-quick-stats">
                            <div class="qs-item">
                                <h4><%= messagedata.length %></h4>
                                <p>Messages</p>
                            </div>
                            <div class="qs-item">
                                <h4><%= studentlength + enrolled.length %></h4>
                                <p>Students</p>
                            </div>
                            <div class="qs-item">
                                <h4><%= Admins.length %></h4>
                                <p>Admins</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ===== MESSAGES FROM OTHER ADMINS ===== -->
            <div class="panel">
                <div class="panel-title">
                    <i class="fas fa-inbox"></i> Messages from Other Admins
                    <span class="subtitle">Recent notifications and messages</span>
                </div>

                <div class="admin-messages-list">

                    <div class="admin-message-item unread">
                        <div class="admin-message-avatar">
                            <img src="https://randomuser.me/api/portraits/men/45.jpg" alt="Peter Kamau" />
                        </div>
                        <div class="admin-message-content">
                            <div class="admin-message-header">
                                <div>
                                    <span class="admin-message-sender">Peter Kamau</span>
                                    <span class="admin-message-role">Registrar</span>
                                </div>
                                <span class="admin-message-time">2 hours ago</span>
                            </div>
                            <div class="admin-message-subject">New Enrollment Approvals</div>
                            <p class="admin-message-text">
                                We have received 5 new enrollment forms today. Please review and approve them so we can assign admission numbers.
                            </p>
                            <div class="admin-message-actions">
                                <a href="#" class="btn btn-outline" style="padding:6px 14px;font-size:12px;">
                                    <i class="fas fa-reply"></i> Reply
                                </a>
                                <a href="javascript:void(0)" onclick="navigateTo('formsubmits')" class="btn btn-accent" style="padding:6px 14px;font-size:12px;">
                                    <i class="fas fa-eye"></i> View Records
                                </a>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- ===== ACCOUNT SETTINGS ===== -->
            <div class="panel">
                <div class="panel-title">
                    <i class="fas fa-user-cog"></i> Account Settings
                    <span class="subtitle">Update your username and password</span>
                </div>

                <!-- Change Username -->
                <form action="/admin-dashboad/update-username" method="post" onsubmit="return confirm('Update your username?');">
                    <h4 style="margin:8px 0 12px;color:var(--primary-dark);font-size:14px;">
                        <i class="fas fa-user-tag"></i> Change Username
                    </h4>

                    <div class="form-grid">
                        <div class="form-group">
                            <label><i class="fas fa-user"></i> Current Username</label>
                            <input type="text" value="<%= name %>" readonly style="background:#f3f4f6;cursor:not-allowed;" />
                            <div class="helper">Your current login username</div>
                        </div>
                        <div class="form-group">
                            <label><i class="fas fa-user-edit"></i> New Username <span class="required">*</span></label>
                            <input type="text" name="newUsername" placeholder="Enter new username" required minlength="4" />
                            <div class="helper">Minimum 4 characters, no spaces</div>
                        </div>
                        <input type="hidden" name="id" value="<%= user %>" />
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-accent">
                            <i class="fas fa-save"></i> Update Username
                        </button>
                    </div>
                </form>

                <!-- Change Password -->
                <form action="/admin-dashboad/update-password" method="post" onsubmit="return confirm('Update your password?');" style="margin-top:24px;padding-top:24px;border-top:2px dashed #e5e7eb;">
                    <h4 style="margin:0 0 12px;color:var(--primary-dark);font-size:14px;">
                        <i class="fas fa-lock"></i> Change Password
                    </h4>

                    <div class="form-grid">
                        <div class="form-group">
                            <label><i class="fas fa-lock"></i> Current Password <span class="required">*</span></label>
                            <input type="password" name="currentPassword" placeholder="Enter current password" required />
                        </div>
                        <div class="form-group">
                            <label><i class="fas fa-key"></i> New Password <span class="required">*</span></label>
                            <input type="password" name="newPassword" placeholder="Enter new password" required minlength="8" />
                            <div class="helper">Minimum 8 characters with a number and symbol</div>
                        </div>
                        <div class="form-group">
                            <label><i class="fas fa-key"></i> Confirm New Password <span class="required">*</span></label>
                            <input type="password" name="confirmPassword" placeholder="Re-enter new password" required minlength="8" />
                        </div>
                        <input type="hidden" name="id" value="<%= user %>" />
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-accent">
