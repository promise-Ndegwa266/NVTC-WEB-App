                                    <td><%= element.TraineeData.CourseDetails.courseApplied %></td>
                                    <td><%= element.TraineeData.CourseDetails.level %></td>
                                    <td>+254 <%= element.TraineeData.ContactDetails.studentTel %></td>
                                    <td><%= element.TraineeData.ContactDetails.studentEmail %></td>
                                    <td>
                                        <div class="action-buttons">
                                            <span class="btn-icon" style="font-size: small; border-radius: 25px; padding:5px 10px; background-color:white;"><a href="#"  title="View"><i class="fas fa-eye"></i></a></span>
                                            <span class="btn-icon" style="font-size: small; border-radius: 25px; padding:5px 10px; background-color:white;"><a href="student_anrolled_delete?id=<%= element._id %>&data=<%= user %>"  title="Delete"><i class="fas fa-trash-alt"></i></a></span>
