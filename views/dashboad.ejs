<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes" />
    <title>NVTC Admin Dashboard</title>
    <!-- Font Awesome 6 (Free) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet" />
    <!-- External CSS -->
    <link rel="stylesheet" href="/dashboad.css">
</head>
<body>

    <!-- ===== MOBILE MENU TOGGLE CHECKBOX ===== -->
    <input type="checkbox" id="menu-toggle-checkbox" />

    <!-- ===== SIDEBAR OVERLAY ===== -->
    <label for="menu-toggle-checkbox" class="sidebar-overlay"></label>

    <!-- ===== SIDEBAR ===== -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <div class="logo">
                <div class="logo-img"></div>
                <div>
                    <h1>NVTC<span>.</span></h1>
                    <div class="sub">Nakuru Vocational Training</div>
                </div>
            </div>
        </div>

        
        <nav class="sidebar-nav" style="overflow-y: auto; scrollbar-width: none;">
            <div class="scroll">
                <div class="nav-label">Main</div>
                <button class="nav-item active" data-section="dashboard" onclick="navigateTo('dashboard')">
                    <i class="fas fa-th-large"></i> Dashboard
                </button>

                <div class="nav-label" style="margin-top:12px;">Student Managment</div>
                <button class="nav-item" data-section="candidates" onclick="navigateTo('candidates')">
                    <i class="fas fa-user-plus"></i> Upload Exam Report
                </button>
                <button class="nav-item" data-section="domitry" onclick="navigateTo('domitry')">
                    <i class="fa-solid fa-bed"></i> Students Dorm request's
                </button>
                <button class="nav-item" data-section="differ" onclick="navigateTo('differ')">
                    <i class="fa-solid fa-user-graduate"></i> Students Deffer request's
                </button>
                
                <div class="nav-label" style="margin-top:12px;">Communication</div>
                <button class="nav-item" data-section="messages" onclick="navigateTo('messages')">
                    <i class="fa-solid fa-message"></i> Message's / Inbox 
                    <% if(messagedata.length > 0){%>
                        <span style="background-color: rgba(237, 49, 49, 0.94);
                        border-radius: 50%; 
                        padding: 0px;
                        width: 0.8cm;
                        height: 0.8cm;
                        display: flex;
                        justify-content: center;
                        align-items: center;"><%= messagedata.length %></span>
                    <%}%>
                </button>
                <button class="nav-item" data-section="memo" onclick="navigateTo('memo')">
                    <i class="fa-solid fa-clipboard"></i> Memo
                </button>

                <!--form enrollment-->
                <div class="nav-label" style="margin-top:12px;">Enrollment</div>
                <button class="nav-item" data-section="students" onclick="navigateTo('students')">
                    <i class="fas fa-user-graduate"></i> Add Student's
                </button>
                <button class="nav-item" data-section="formsubmits" onclick="navigateTo('formsubmits')">
                    <i class="fa-solid fa-file"></i> Form's Submited online
                </button>
                <button class="nav-item" data-section="studentenrolld" onclick="navigateTo('studentenrolld')">
                    <i class="fas fa-user-graduate"></i> Students Enrolled
                </button>
                <!--form enrollment-->

                <div class="nav-label" style="margin-top:12px;">Voting</div>

                <button class="nav-item" data-section="monitor" onclick="navigateTo('monitor')">
                    <i class="fas fa-chart-line"></i> Monitor Vote
                    <% if(thelength > 0 ){ %><span class="badge">LIVE</span><%} %>
                </button>
                <button class="nav-item" data-section="results" onclick="navigateTo('results')">
                    <i class="fas fa-trophy"></i> Results
                </button>
            </div>
        </nav>
        

        <!-- ===== LOGOUT BUTTON ===== -->
        <div class="sidebar-logout">
            <a href="/admin-dashboad/admin-logout/<%= user%>">
                <button class="logout-btn">
                    <i class="fas fa-sign-out-alt"></i>
                    <span class="logout-text">Logout</span>
                    <span class="logout-icon-right"><i class="fas fa-arrow-right"></i></span>
                </button>
            </a>
        </div>

        <div class="sidebar-footer">
            &copy; <%= date %> NVTC Admin
        </div>
    </aside>

    <!-- ===== MAIN CONTENT ===== -->
    <div class="main-content">

        <!-- ===== HEADER ===== -->
        <header class="page-header">
            <div class="header-left">
                <label for="menu-toggle-checkbox" class="menu-toggle" id="menuToggle">
                    <i class="fas fa-bars"></i>
                </label>
                <h2 id="pageTitle">
                    Dashboard
                    <small>Nakuru VTC</small>
                </h2>
            </div>
            <div class="header-actions">
                <div class="date-badge">
                    <i class="fas fa-calendar-day"></i>
                    <span><%= date %></span>
                </div>
                <div class="admin-avatar" onclick="navigateTo('admin')">
                    <div class="avatar" id="headerAvatar">
                        <img src="/img/logo.png" id="prof" alt="Admin" style="width: 36px; height: 36px; border-radius: 50%;">
                    </div>
                </div>
            </div>
        </header>

        <!-- ============================================================ -->
        <!-- SECTION: DASHBOARD                                            -->
        <!-- ============================================================ -->
        <section class="section visible" id="section-dashboard">

            <div class="toast-demo">
                <i class="fas fa-circle-check"></i>
                Admin session: <strong>active</strong> · <%= name %>
            </div>

            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-number"><%= studentlength + enrolled.length %></div>
                    <div class="stat-label">Total Students</div>
                    <div class="stat-change"><i class="fas fa-arrow-up"></i></div>
                </div>
                <div class="stat-card">
                    <div class="stat-number"><%= thelength %></div>
                    <div class="stat-label">Active student council Candidates</div>
                    <div class="stat-change"><i class="fas fa-plus"></i> <%= thelength %></div>
                </div>
                <div class="stat-card">
                    <div class="stat-number"><%= activeadmin %></div>
                    <div class="stat-label">Active Admin</div>
                    <div class="stat-change"><i class="fas fa-arrow-up"></i></div>
                </div>
                <div class="stat-card">
                    <time datetime="" class="stat-number"><%= time %></time>
                    <div class="stat-label">East African Time</div>
                    <div class="stat-change" style="background:#fef3c7;color:#d97706;">
                        <i class="fas fa-hourglass-half"></i> Timer
                    </div>
                </div>
            </div>

            <div class="quick-grid">
                <div class="quick-card" onclick="navigateTo('candidates')">
                    <div class="qc-icon blue"><i class="fas fa-user-plus"></i></div>
                    <div class="qc-title">Add Candidate</div>
                    <div class="qc-desc">Register nominee</div>
                    <div class="qc-link"><i class="fas fa-arrow-right"></i> Go</div>
                </div>
                <div class="quick-card" onclick="navigateTo('students')">
                    <div class="qc-icon blue"><i class="fas fa-user-graduate"></i></div>
                    <div class="qc-title">Add Student</div>
                    <div class="qc-desc">Enroll voter</div>
                    <div class="qc-link"><i class="fas fa-arrow-right"></i> Go</div>
                </div>
                <div class="quick-card" onclick="navigateTo('monitor')">
                    <div class="qc-icon blue"><i class="fas fa-check-circle"></i></div>
                    <div class="qc-title">Monitor Vote</div>
                    <div class="qc-desc">Live updates</div>
                    <div class="stat-icon green"></div>
                </div>
            </div>
            <div class="stat-card twoo" style="margin-top:0.3cm;">
                <h3>Exam body registrations</h3>
                <div style="margin-top:16px;display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;">
                    <div class="stat-card small">
                        <div class="stat-number"><%= (examStats && examStats.cbet) ? examStats.cbet + examStats.cbetenrollment : 0 %></div>
                        <div class="stat-label">CBET Registrations</div>
                    </div>
                    <div class="stat-card small">
                        <div class="stat-number"><%= (examStats && examStats.nita) ? examStats.nita + examStats.nitaenrollment : 0 %></div>
                        <div class="stat-label">NITA Registrations</div>
                    </div>
                    <div class="stat-card small">
                        <div class="stat-number"><%= (examStats && examStats.total) ? examStats.total + enrolled.length : 0 %></div>
                        <div class="stat-label">Total Exam Registrations</div>
                    </div>
                </div>
            </div>
            
            <% if(Admininfo.prevlage == "MainAdmin"){ %>
                <div class="candadate-managment">
                    <a href="/admin-dashboad/new-admin/<%= user %>"><i class="fas fa-user-plus"></i> Admin Management </a>
                </div>
            <% } %>

        </section>

        <!-- ============================================================ -->
        <!-- SECTION: ADD EXAM REPORT                                       -->
        <!-- ============================================================ -->
        <section class="section" id="section-candidates">
            <div class="panel">
                <div class="panel-title">
                    <i class="fas fa-user-plus"></i> Candidate
                    <span class="subtitle">Fill in the details</span>
                </div>
                <div class="panel">
                <div class="panel-title">
                    <i class="fas fa-file-alt"></i> Exam Reports 
                    <span class="subtitle">Add exam report and view exam registrations by body</span>
                </div>

                <form action="/admin-dashboad/exam-report" method="post" onsubmit="return confirm('Submit exam report?');">
                    <div class="form-grid">
                        <div class="form-group">
                            <label><i class="fas fa-id-card"></i> Student Admission No. <span class="required">*</span></label>
                            <input type="number" name="admissionno" placeholder="e.g. 12345" required />
                        </div>
                        <div class="form-group">
                            <label><i class="fas fa-user"></i> Name <span class="required">*</span></label>
                            <input type="text" name="studentname" placeholder="e.g. Grace Wanjiku" required />
                        </div>
                        <div class="form-group">
                            <label><i class="fas fa-building"></i> Examination Body</label>
                            <select name="examBody" required>
                                <option value="">Select body...</option>
                                <option value="CBET">CBET</option>
                                <option value="NITA">NITA</option>
                            </select>
            
                            <label><i class="fas fa-building"></i> Level</label>
                            <select name="level" required>
                                <option value="">Select level...</option>
                                <option  value="3">Level 3</option>
                                <option type="number" value="4">Level 4</option>
                                <option type="number" value="5">Level 5</option>
                            </select>

                            <label><i class="fas fa-building"></i> Modules</label>
                            <select name="modules" required>
                                <option value="">Select module...</option>
                                <option value="1">Module 1</option>
                                <option value="2">Module 2</option>
                                <option value="3">Module 3</option>
                                <option value="4">Module 4</option>
                            </select>
                            
                        </div>
                        <div class="form-group">
                            <label><i class="fas fa-book"></i> Exam Name</label>
                            <input type="text" name="examName" placeholder="e.g. Mathematics" required/>
                        </div>
                        <div class="form-group">
                            <label><i class="fas fa-calendar"></i> Exam Date</label>
                            <input type="date" name="examDate" required />
                        </div>
                        <div class="form-group">
                            <label><i class="fas fa-chart-line"></i> Score / Status</label>
                            <input type="text" name="score" placeholder="e.g. 78 or Pass/Fail" required />
                        </div>
                        <input style="display:none" type="text" name="id" value="<%= user %>">
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="btn btn-accent"><i class="fas fa-save"></i> Save Report</button>
                        <button type="reset" class="btn btn-outline"><i class="fas fa-undo"></i> Clear</button>
                    </div>
                </form>

                <div style="margin-top:16px;display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;">
                    <div class="stat-card small">
                       
                        <div class="stat-number"><%= (examStats && examStats.cbet) ? examStats.cbet + examStats.cbetenrollment : 0 %></div>
                        <div class="stat-label">CBET Registrations</div>
                    </div>
                    <div class="stat-card small">
                       
                        <div class="stat-number"><%= (examStats && examStats.nita) ? examStats.nita + examStats.nitaenrollment : 0 %></div>
                        <div class="stat-label">NITA Registrations</div>
                    </div>
                    <div class="stat-card small">
                        
                        <div class="stat-number"><%= (examStats && examStats.total) ? examStats.total + enrolled.length : 0 %></div>
                        <div class="stat-label">Total Exam Registrations</div>
                    </div>
                </div>

            </div>

                
            </div>
        </section>

        <!-- ============================================================ -->
        <!-- SECTION: ADD STUDENT                                          -->
        <!-- ============================================================ -->
        <section class="section" id="section-students">
            <div class="panel">
                <div class="panel-title">
                    <i class="fas fa-user-graduate"></i> Enroll Student
                    <span class="subtitle">Add to Database</span>
                </div>

                <form action="/admin-dashboad/student-data" method="post" onsubmit="confirm('Student Uploaded!');">
                    <div class="form-grid">
                        <div class="form-group">
                            <label><i class="fas fa-user"></i> First Name <span class="required">*</span></label>
                            <input type="text" name="firstname" placeholder="e.g. Grace" required />
                        </div>
                        <div class="form-group">
                            <label><i class="fas fa-user"></i> Second Name <span class="required">*</span></label>
                            <input type="text" name="secondname" placeholder="e.g. Wanjiru" required />
                            <div class="helper">Middle name or second surname</div>
                        </div>
                        <div class="form-group">
                            <label><i class="fas fa-id-card"></i> Registration No. <span class="required">*</span></label>
                            <input type="number" name="admissionno" placeholder="e.g. NVTC-20024" required />
                        </div>
                        <div class="form-group">
                            <label><i class="fa-solid fa-envelope"></i> Email <span class="required">*</span></label>
                            <input type="email" name="email" placeholder="e.g. grace.wanjiru@example.com" required />
                        </div>
                        <!--check this first promise-->
                        <div class="form-group">
                            <label><i class="fa-solid fa-envelope"></i> Gender <span class="required">*</span></label>
                            <input type="text" name="gender" placeholder="e.g. Female" required />
                        </div>
                        
                        <div class="form-group">
                            <label><i class="fas fa-book"></i> Course / Department</label>
                            <select name="cource" required>
                                <option value="">Select course...</option>
                                <option value="Electrical Engineering">Electrical Engineering</option>
                                <option value="Plumbing & Pipefitting">Plumbing &amp; Pipefitting</option>
                                <option value="Welding & Fabrication">Welding &amp; Fabrication</option>
                                <option value="Automotive Mechanics">Automotive Mechanics</option>
                                <option value="ICT & Computer Science">ICT &amp; Computer Science</option>
                                <option value="Carpentry & Joinery">Carpentry &amp; Joinery</option>
                                <option value="Fashion & Design">Fashions &amp; Design</option>
                                <option value="Building & Construction">Building &amp; Construction</option>
                                <option value="Food & Bevarage">Food &amp; Bevarage</option>
                                <option value="Business Administration">Business Administration</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label><i class="fas fa-calendar"></i> Year of Study</label>
                            <select name="yearofstudy" required>
                                <option value="">Select year...</option>
                                <option value="Year 1">Year 1</option>
                                <option value="Year 2">Year 2</option>
                                <option value="Year 3">Year 3</option>
                                <option value="Year 4">Year 4</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label><i class="fas fa-book"></i> Exam Body</label>
                            <select name="exambody" required>
                                <option value="">Select Exam Body...</option>
                                <option value="CBET">CBET</option>
                                <option value="NITA">NITA</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label><i class="fas fa-calendar"></i> Intake date. <span class="required">*</span></label>
                            <input type="date" name="intakedate"  required />
                        </div>
                        <input style="display: none;" type="text" name="id" value="<%= user %>">
                        
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="btn btn-accent">
                            <i class="fas fa-save"></i> Submit
                        </button>
                        <button type="reset" class="btn btn-outline">
                            <i class="fas fa-undo"></i> Clear
                        </button>
                    </div>
                </form>
            </div>
            <!-- ============================================================ -->
            <!-- PANEL: Student Search                                        -->
            <!-- ============================================================ -->
            <div class="panel">
                <div class="panel-title">
                    <i class="fas fa-search"></i> Find Student
                    <span class="subtitle">Search students in the database</span>
                </div>

                <form action="/admin-dashboad/student-search" method="get">
                    <div class="form-grid">
                        <div class="form-group">
                            <label><i class="fas fa-id-card"></i> Admission No.</label>
                            <input type="text" name="admissionno" placeholder="e.g. NVTC-20024" />
                        </div>
                        <div class="form-group">
                            <label><i class="fas fa-user"></i> First Name</label>
                            <input type="text" name="firstname" placeholder="e.g. Grace" />
                        </div>
                        <div class="form-group">
                            <label><i class="fas fa-user"></i> Second Name</label>
                            <input type="text" name="secondname" placeholder="e.g. Wanjiru" />
                        </div>
                        <div class="form-group">
                            <label><i class="fas fa-building"></i> Exam Body</label>
                            <select name="examBody">
                                <option value="">Any</option>
                                <option value="CBET">CBET</option>
                                <option value="NITA">NITA</option>
                            </select>
                        </div>
                        <input type="hidden" name="name" value="<%= name %>">
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="btn btn-accent"><i class="fas fa-search"></i> Search</button>
                        <button type="reset" class="btn btn-outline"><i class="fas fa-undo"></i> Clear</button>
                    </div>
                </form>

                <% if (typeof searchResults !== 'undefined' && searchResults && searchResults.length > 0) { %>
                    <div style="margin-top:12px;">
                        <h4>Search Results (<%= searchResults.length %>)</h4>
                        <% searchResults.forEach(s => { %>
                            <div class="candidate-chip" style="display:flex;justify-content:space-between;">
                                <div>
                                    <strong><%= s.name.firstName %> <%= s.name.secondName %></strong>
                                    — <%= s.adimmisionNumber %>
                                    <span style="color:var(--text-light);">(<%= s.cource %> | <%= s.intake.toDateString() %> | <%= s.exambody %> )</span>
                                    <a href="/admin-dashboad/detete-student/<%= s.adimmisionNumber %>/<%= user %>" style="color: rgba(240, 34, 34, 0.905);"><i class="fas fa-trash-alt"></i></a>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } else if (typeof searchResults !== 'undefined') { %>
                    <div style="margin-top:12px;color:var(--text-light);">No students found for the query.</div>
                <% } %>
            </div>
        </section>

        <!-- ============================================================ -->
        <!-- SECTION: MONITOR VOTE                                        -->
        <!-- ============================================================ -->
        <section class="section" id="section-monitor">

            <div class="total-votes-summary">
                <div class="tv-item">
                    <span class="tv-label"><i class="fas fa-users"></i> Voters</span>
                    <span class="tv-number"><%= studentlength %></span>
                </div>
                
                <div class="tv-item">
                    <span class="tv-label"><i class="fas fa-clock"></i> Status</span>
                    <span class="tv-number" style="font-size:20px;display:flex;align-items:center;gap:6px;">
                        <% if (thelength > 0){%>
                        <span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:#22c55e;animation:pulse-dot 1.2s infinite;"></span>
                        LIVE 
                        <%}%>
                        <% if (thelength <= 0){%>
                            <span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:#da5026;animation:pulse-dot 1.2s infinite;"></span>
                        OFFLINE
                        <%} %>
                    </span>
                </div>
            </div>

            <div class="panel">
                <div class="panel-title">
                    <i class="fas fa-chart-simple"></i> Live Monitoring
                    <span class="subtitle"><i class="fas fa-sync-alt fa-spin"></i> Auto-refresh</span>
                </div>

                <div class="monitor-table-wrap">
                    <table class="monitor-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Candidate</th>
                                <th>Position</th>
                                <th>Votes</th>
                                <th>Progress</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>

                            <% candite.forEach((element)=>{ %>
                                <tr>
                                    <td><i class="fas fa-circle" style="color:#3b82f6;font-size:8px;"></i></td>
                                    <td>
                                        <div class="candidate-info">
                                            <div>
                                                <div class="candidate-name"><h3><%= element.name.presidentName %></h3></div>
                                                <div class="candidate-name"><p style="color: rgb(117, 116, 116);">With: <%= element.name.runingMateName %></p></div>
                                            </div>
                                        </div>
                                    </td>
                                    <td><span style="font-size:12px;color:var(--text-light);"><%= element.position%></span></td>
                                    <td><span class="vote-count"><%= element.votes %></span></td>
                                    <td>
                                        <div class="vote-bar-wrap">
                                            <div class="vote-bar-track">
                                                <div class="vote-bar-fill" style="width:<%= ((element.votes/studentlength)*100).toFixed(2) %>%;"></div>
                                            </div>
                                            <span style="font-size:12px;font-weight:600;color:var(--text-light);"><%= ((element.votes/studentlength)*100).toFixed(2) %> %</span>
                                        </div>
                                    </td>
                                    <td><span class="status-badge live">Live</span></td>
                                    
                                </tr>
                            <% }) %>
                            
                        </tbody>
                    </table>
                </div>
                
                <form style="margin-top: 0.5cm; background-color: rgba(248, 247, 247, 0.859); padding: 10px; border-radius: 20px;" action="/admin-dashboad/candidates" method="post" onsubmit="confirm('Candidate Uploaded!');">
                    <h3 style="margin-bottom: 20px; padding: 10px;">Upload candidates</h3>
                    <div class="form-grid">
                        <div class="form-group">
                            <label><i class="fas fa-user"></i> Candidate's Name <span class="required">*</span></label>
                            <input type="text" name="cadidatename" placeholder="e.g. James Kiprop" required />
                        </div>
                        <div class="form-group">
                            <label><i class="fas fa-id-card"></i> Candidate's Admission No. <span class="required">*</span></label>
                            <input type="number" name="cadidateadmision" placeholder="e.g. 20078" required />
                            <div class="helper">Student admission number</div>
                        </div>
                        <div class="form-group">
                            <label><i class="fas fa-briefcase"></i> Position <span class="required">*</span></label>
                            <select name="position" required>
                                <option value="">Select position...</option>
                                <option>President</option>
                                <option>Environment</option>
                                <option>Sports </option>
                                
                            </select>
                        </div>
                        <div class="form-group">
                            <label><i class="fas fa-user-friends"></i> Running Mate's Name</label>
                            <input type="text" name="runingmatename" placeholder="e.g. Grace Wanjiru" required />
