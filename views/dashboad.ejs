                                            <h5><span style="color: rgb(180, 175, 175);">Level:</span> <%= element.TraineeData.CourseDetails.level %></h5>
                                            <h5><span style="color: rgb(180, 175, 175);">Mode of study:</span> <%= element.TraineeData.CourseDetails.modeOfStudy %></h5>
                                            <h5><span style="color: rgb(180, 175, 175);">Type:</span> <%= element.TraineeData.CourseDetails.type %></h5>
                                        </div>
