                                            <h5><span style="color: rgb(180, 175, 175);">Education level:</span> <%= element.TraineeData.EducationDetails.educationLevel %></h5>
                                            <h5><span style="color: rgb(180, 175, 175);">Grade attained:</span> <%= element.TraineeData.EducationDetails.gradeAttained %></h5>
                                        </div>
                                    </div>
                                
                                </div>
                                <div class="tittle-container">
                                    <div class="btn-container">
                                        <a href="view_Enrollment_Form?id=<%= element._id %>&data=<%= user %>"><button class="header-text enroll-btn view"><span style="font-size: small; border-radius: 25px; padding:5px 10px; background-color:white;"><i class="fa-solid fa-table"></i></span> View</button></a>
                                        <a href="student_anrolled_delete?id=<%= element._id %>&data=<%= user %>"><button class="header-text enroll-btn delete"><span style="font-size: small; border-radius: 25px; padding:5px 10px; background-color:white;"><i class="fas fa-trash-alt"></i></span> Delete</button></a>
                                    </div>
                                </div>
                            </div>

                            
                        <%})%>
                    </div>
                </div>
            </div>
        </section>


        <!-- ============================================================ -->
        <!-- SECTION: ENROLLMENT FORM NOTIFICATION                        -->
        <!-- ============================================================ -->

        <section class="section" id="Students-admided">
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-number"><%= enrolled.length %></div>
                    <div class="stat-label">Total Students Enrolled</div>
                    <div class="stat-change"><i class="fas fa-arrow-up"></i></div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">9</div>
                    <div class="stat-label">Courses</div>
                    <div class="stat-change"><i class="fas fa-plus"></i> 9</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number"><%= Admins.length %></div>
                    <div class="stat-label">Total Admin</div>
                    <div class="stat-change"><i class="fas fa-arrow-up"></i></div>
                </div>
                <div class="stat-card">
                    <div class="stat-number"><%= instuctors.length %></div>
                    <div class="stat-label">Total Instructors</div>
                    <div class="stat-change"><i class="fas fa-plus"></i> <%= instuctors.length %></div>
                </div>
            </div>

            <div class="table-container">
                <div class="table-wrapper">
                    <table class="tbl-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Admission No</th>
                                <th>Full Name</th>
                                <th>Gender</th>
                                <th>Course</th>
