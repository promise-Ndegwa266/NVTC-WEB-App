<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>Submission Failed – NVTC</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet" />

    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

    <!-- External CSS -->
    <link rel="stylesheet" href="/style-save-error.css" />
</head>
<body>

    <div class="container">

        <!-- ===== ERROR CARD ===== -->
        <div class="error-card">

            <!-- Animated Icon -->
            <div class="icon-wrapper">
                <div class="icon-ring">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>
                <div class="icon-badge">
                    <i class="fas fa-times"></i>
                </div>
            </div>

            <!-- Title & Message -->
            <h2>Submission Failed!</h2>
            <p class="message">
                Unfortunately, your uploaded data could not be saved to the database
                due to an unexpected error. Please fill out the form again and resubmit.
            </p>

            <!-- Error Details -->
            <div class="error-details">
                <div class="error-icon">
                    <i class="fas fa-database"></i>
                </div>
                <div class="error-text">
                    <h4><i class="fas fa-times-circle"></i> Database Save Error</h4>
                    <p>Your data was received but could not be stored. No changes were made to the system.</p>
                </div>
            </div>

            <!-- Possible Reasons -->
            <div class="reasons-list">
                <div class="reason-item">
                    <div class="reason-icon">
                        <i class="fas fa-wifi"></i>
                    </div>
                    <div class="reason-text">
                        <strong>Network issue:</strong> Your connection may have dropped during submission.
                    </div>
                </div>

                <div class="reason-item">
                    <div class="reason-icon">
                        <i class="fas fa-server"></i>
                    </div>
                    <div class="reason-text">
                        <strong>Server error:</strong> The server may be temporarily unavailable or overloaded.
                    </div>
                </div>

                <div class="reason-item">
                    <div class="reason-icon">
                        <i class="fas fa-file-alt"></i>
                    </div>
                    <div class="reason-text">
                        <strong>Invalid data:</strong> Some fields may contain invalid or incomplete information.
                    </div>
                </div>

                <div class="reason-item">
                    <div class="reason-icon">
                        <i class="fas fa-clock"></i>
                    </div>
                    <div class="reason-text">
                        <strong>Session timeout:</strong> Your session may have expired before submission completed.
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="btn-group">
                <a href="/enrollment-form" class="btn btn-danger">
                    <i class="fas fa-redo-alt"></i> Fill Form Again
                </a>
                <a href="/" class="btn btn-secondary">
                    <i class="fas fa-home"></i> Return to Home
                </a>
            </div>

            <!-- Help Text -->
            <p class="help-text">
                <i class="fas fa-info-circle"></i>
                If the problem persists, contact the administrator at <strong>0702 474 169</strong>
            </p>

        </div>

        <!-- ===== FOOTER ===== -->
        <div class="footer">
            <p>
                <i class="fas fa-shield-alt" style="color:var(--primary);"></i>
                County Government of Nakuru – Department of Education, ICT & eGovernment
            </p>
            <p style="margin-top:4px;">
                <a href="/"><i class="fas fa-arrow-left"></i> Back to Home</a>
            </p>
        </div>
    </div>

</body>
</html>