<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Password Recovery – NVTC Admin</title>

    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

    <link rel="stylesheet" href="/style-recover.css" />
    <link rel="icon" type="image/x-icon" href="/img/logo.png" />
</head>
<body>
    <div class="container">
        <div class="brand">
            <div class="logo-icon logo-img">
                
            </div>
            <h1>NVTC<span>.</span></h1>
            <p>Nakuru Vocational Training Centre</p>
        </div>

        <div class="card">
            <div class="header">
                <div class="icon-ring">
                    <i class="fas fa-key"></i>
                </div>
                <h2>Recover Password</h2>
                <p>Enter your registered User name to receive a recovery password</p>
            </div>

            <form action="/password-backup" method="post">
                <div class="form-group">
                    <label for="email">User name <span class="required">*</span></label>
                    <div class="input-wrapper" id="emailWrapper">
                        <input
                        type="text"
                        id="email"
                        placeholder="admin "
                        autocomplete="username"
                        name="username"
                        required
                        />
                        <span class="icon"><i class="fas fa-envelope"></i></span>
                    </div>
                    <div class="error-msg" id="emailError">
                        <i class="fas fa-exclamation-circle"></i>
                        <span>Please enter a valid User name.</span>
                    </div>
                </div>

                <p class="info-text">
                    <i class="fas fa-info-circle"></i>
                    <span style="color: rgb(24, 144, 18); font-size: large;"><%= data %></span>
                </p>

                <button type="submit" class="btn btn-primary" id="sendBtn">
                    <span class="btn-text"><i class="fas fa-paper-plane"></i> Send Recovery Link</span>
                    <span class="spinner"></span>
                </button>
                <a href="/admin-dashboad/admin-login">
                    <button type="button" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Back to Login
                    </button>
                </a>
            </form>

            <div class="footer">
                <p>
                    <i class="fas fa-shield-alt" style="color:var(--primary);"></i>
                    Secure admin access
                </p>
            </div>
        </div>
    </div>
</body>
</html>