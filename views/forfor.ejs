<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>404 – Page Not Found | NVTC</title>

    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet" />

    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />


    <link rel="stylesheet" href="/style-404.css" />
</head>
<body>

    <div class="particles" aria-hidden="true">
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
    </div>

    <div class="floating-shapes" aria-hidden="true">
        <div class="shape"></div>
        <div class="shape"></div>
        <div class="shape"></div>
    </div>

    <div class="error-container" role="main">
        <span class="error-icon" aria-hidden="true">
            <i class="fas fa-compass"></i>
        </span>

        <div class="error-code">
            <span class="code">404</span>
            <span class="badge"><i class="fas fa-exclamation-triangle"></i> Lost</span>
        </div>

        <h1 class="error-title">
            Oops! Page <span>Not Found</span>
        </h1>

        <p class="error-desc">
            The page you're looking for might have been moved, deleted, or never existed.
            Don't worry — we'll help you get back on track.
        </p>

        <a href="/" class="btn btn-primary">
            <i class="fas fa-home"></i> Back to Home
        </a>

        <div class="error-footer">
            <a href="/"><i class="fas fa-home"></i> Home</a>
            <a href="/#courses"><i class="fas fa-graduation-cap"></i> Courses</a>
            <a href="/#admissions"><i class="fas fa-envelope"></i> Contact</a>
            <a href="/admin-login"><i class="fas fa-lock"></i> Admin</a>
        </div>
    </div>

    <script src="/errorforfor.js">
    </script>
</body>
</html>