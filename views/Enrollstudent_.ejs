<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>Enroll Student – NVTC Admin</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet" />

    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

    <!-- External CSS -->
    <link rel="stylesheet" href="/style-adminenroll.css" />
    <link rel="icon" type="image/x-icon" href="/img/logo.png" />
</head>
<body>

    <main class="main-content">

        <!-- ===== APPLICANT SUMMARY ===== -->
        <div class="applicant-summary">
            <div class="summary-info">
                <h2><%= studentData.TraineeData.Name.firstName %> <%= studentData.TraineeData.Name.middleName %> <%= studentData.TraineeData.Name.sureName %></h2>
                <p>
                    <i class="fas fa-graduation-cap"></i> <%= studentData.TraineeData.CourseDetails.courseApplied %>
                    <span class="dot">•</span>
                    <i class="fas fa-layer-group"></i> <%= studentData.TraineeData.CourseDetails.level %>
                    <span class="dot">•</span>
                    <i class="fas fa-phone"></i> <%= studentData.TraineeData.ContactDetails.studentTel %>
                </p>
                <span class="status-tag pending">
                    <i class="fas fa-clock"></i> Pending Admission
                </span>
            </div>
        </div>

        <!-- ===== ENROLLMENT FORM ===== -->
        <form id="enrollForm" class="enroll-form">

            <!-- ===== ADMISSION DETAILS ===== -->
            <div class="form-card">
                <div class="section-title">
                    <i class="fas fa-id-card"></i> Admission Details
                </div>
                <p class="section-subtitle">Assign the student's official admission information</p>

                <div class="form-grid">
                    <div class="form-group">
                        <label for="admissionNumber">Admission Number <span class="required">*</span></label>
                        <div class="input-wrapper">
                            <input type="text" id="admissionNumber" value="NVTC-ADM-<%= addmition %>" placeholder="ADM-XXX" required />
                            <span class="icon"><i class="fas fa-hashtag"></i></span>
                        </div>
                        <p class="helper-text">Auto-generated based on enrollment order</p>
                    </div>

                    <div class="form-group">
                        <label for="admissionDate">Admission Date <span class="required">*</span></label>
                        <div class="input-wrapper">
                            <input type="date" id="admissionDate" value="2024-09-01" required />
                            <span class="icon"><i class="fas fa-calendar-check"></i></span>
                        </div>
                    </div>


                    <div class="form-group">
                        <label for="intake">Intake / Term <span class="required">*</span></label>
                        <div class="input-wrapper">
                            <select id="intake" required>
                                <option value="(Jan - Apr) intake">(Jan – Apr) intake</option>
                                <option value="(May - Aug) intake">(May – Aug) intake</option>
                                <option value="(Sep - Dec) intake" selected>(Sep – Dec) intake</option>
                            </select>
                            <span class="icon"><i class="fas fa-calendar-week"></i></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ===== CLASS ASSIGNMENT ===== -->
            <div class="form-card">
                <div class="section-title">
                    <i class="fas fa-school"></i> Class Assignment
                </div>
                <p class="section-subtitle">Assign the student to a class, stream, and instructor</p>

                <div class="form-grid">
                    <div class="form-group">
                        <label for="department">Department <span class="required">*</span></label>
                        <div class="input-wrapper">
                            <select id="department" required>
                                <option value="">Select Department</option>
                                <option value="Engineering">Engineering</option>
                                <option value="ICT">ICT &amp; Computer Studies</option>
                                <option value="Construction">Building &amp; Construction</option>
                                <option value="Hospitality">Hospitality</option>
                                <option value="Creative Arts">Creative Arts</option>
                                <option value="Beauty">Cosmetology &amp; Beauty</option>
                            </select>
                            <span class="icon"><i class="fas fa-building"></i></span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="courseAssigned">Course Assigned <span class="required">*</span></label>
                        <div class="input-wrapper">
                            <input type="text" id="courseAssigned" value="<%= studentData.TraineeData.CourseDetails.courseApplied %>" required />
                            <span class="icon"><i class="fas fa-graduation-cap"></i></span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="instructor">Assigned Instructor <span class="required">*</span></label>
                        <div class="input-wrapper">
                            <select id="instructor" required>
                                <option value="">Select Instructor</option>
                                <% Instructors.forEach((element)=>{ %>
                                    <option value="<%= element.name.firstName%> <%= element.name.firstName%>" selected><%= element.name.firstName%> <%= element.name.firstName%></option>
                                <% }) %>
                            </select>
                            <span class="icon"><i class="fas fa-chalkboard-teacher"></i></span>
                        </div>
                    </div>

                </div>
            </div>

            <!-- ===== OFFICIAL USE ONLY ===== -->
            <div class="form-card">
                <div class="section-title" style="color:var(--gray-700);">
                    <i class="fas fa-stamp"></i> OFFICIAL USE ONLY
                </div>

                <div class="form-grid">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="authName">Authorization for Admission By:</label>
                            <div class="input-wrapper">
                                <input type="text" id="authName" placeholder="Authorizing officer name" />
                                <span class="icon"><i class="fas fa-user-tie"></i></span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="authDesignation">Designation</label>
                            <div class="input-wrapper">
                                <input type="text" id="authDesignation" placeholder="e.g. Registrar" />
                                <span class="icon"><i class="fas fa-briefcase"></i></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="authSign">Sign</label>
                            <div class="input-wrapper">
                                <input type="text" id="authSign" placeholder="Authorizing signature" />
                                <span class="icon"><i class="fas fa-signature"></i></span>
                            </div>
                        </div>
                    </div>
                    
                </div>
            </div>

            

            <!-- ===== ACCOMMODATION ===== -->
            <div class="form-card">
                <div class="section-title">
                    <i class="fas fa-bed"></i> Accommodation
                </div>
                <p class="section-subtitle">Assign accommodation for boarding students</p>

                <div class="form-grid">
                    <div class="form-group">
                        <label>Accommodation Type <span class="required">*</span></label>
                        <div class="inline-group">
                            <% if(studentData.TraineeData.CourseDetails.type == "Day Scholar"){ %>
                                <label class="radio-label">
                                    <input type="radio" name="accommodation" value="Day Scholar" />
                                    <span>Day Scholar</span>
                                </label>
                            <% } else {%>
                                <label class="radio-label">
                                    <input type="radio" name="accommodation" value="Boarder" />
                                    <span>Boarder</span>
                                </label>
                            <% } %>
                        </div>
                    </div>

                    <% if(studentData.TraineeData.CourseDetails.type !== "Day Scholar"){ %>
                        <div class="form-group">
                            <label for="hostel">Hostel / Dormitory</label>
                            <div class="input-wrapper">
                                <select id="hostel">
                                    <option value="">Not Applicable</option>
                                    <option value="Male Hostel A">Male Hostel A</option>
                                    <option value="Male Hostel B">Male Hostel B</option>
                                    <option value="Female Hostel A">Female Hostel A</option>
                                    <option value="Female Hostel B">Female Hostel B</option>
                                </select>
                                <span class="icon"><i class="fas fa-building"></i></span>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="roomNo">Room Number</label>
                            <div class="input-wrapper">
                                <input type="text" id="roomNo" placeholder="e.g. Room 12" />
                                <span class="icon"><i class="fas fa-door-closed"></i></span>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="bedNo">Bed Number</label>
                            <div class="input-wrapper">
                                <input type="text" id="bedNo" placeholder="e.g. Bed 4" />
                                <span class="icon"><i class="fas fa-bed"></i></span>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- ===== ADDITIONAL NOTES ===== -->
            <div class="form-card">
                <div class="section-title">
                    <i class="fas fa-sticky-note"></i> Additional
                </div>

                <div class="form-group">
                    <label class="checkbox-label">
                        <input type="checkbox" id="sendNotification" checked />
                        <span>Send admission notification to the student's email and phone</span>
                    </label>
                </div>

                <div class="form-group">
                    <label class="checkbox-label">
                        <input type="checkbox" id="printLetter" />
                        <span>Generate and print admission letter after enrollment</span>
                    </label>
                </div>
            </div>

            <!-- ===== ACTION BUTTONS ===== -->
            <div class="action-bar">
                <button type="reset" class="btn btn-secondary">
                    <i class="fas fa-times"></i> Reset
                </button>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-check-circle"></i> Approve &amp; Enroll Student
                </button>
            </div>

        </form>

    </main>

</body>
</html>