<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>Submission Received – NVTC</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet" />

    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

    <!-- External CSS -->
    <link rel="stylesheet" href="/style-submission-success.css" />
</head>
<body>

    <div class="container">

       

        <!-- ===== SUCCESS CARD ===== -->
        <div class="success-card">

            <!-- Animated Icon -->
            <div class="icon-wrapper">
                <div class="icon-ring">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div class="icon-badge">
                    <i class="fas fa-paper-plane"></i>
                </div>
            </div>

            <!-- Title & Message -->
            <h2>Form Submitted Successfully!</h2>
            <p class="message">
                Thank you for submitting your form. Your request has been received
                and is now being processed. You will be notified once the review is complete.
            </p>

            <!-- Processing Indicator -->
            <div class="processing-box">
                <div class="spinner"></div>
                <div class="processing-text">
                    <h4><i class="fas fa-cog"></i> Processing Your Request</h4>
                    <p>Our team is reviewing your submission. This usually takes 1–3 business days.</p>
                </div>
            </div>

            <!-- Info List -->
            <div class="info-list">
                <div class="info-item">
                    <div class="info-icon">
                        <i class="fas fa-envelope"></i>
                    </div>
                    <div class="info-text">
                        <h4>Check Your Email</h4>
                        <p>A confirmation email has been sent to your registered address with a summary of your submission.</p>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon">
                        <i class="fas fa-clock"></i>
                    </div>
                    <div class="info-text">
                        <h4>Wait for Approval</h4>
                        <p>Our admissions team will review your application and contact you with the next steps.</p>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon">
                        <i class="fas fa-phone"></i>
                    </div>
                    <div class="info-text">
                        <h4>Need Assistance?</h4>
                        <p>Call us at <strong>0702 474 169</strong> or visit the campus in Bondeni, Nakuru.</p>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="btn-group">
                <a href="/" class="btn btn-primary">
                    <i class="fas fa-home"></i> Return to Home
                </a>
            </div>


        </div>

        <!-- ===== FOOTER ===== -->
        <div class="footer">
            <p>
                <i class="fas fa-shield-alt" style="color:var(--primary);"></i>
                County Government of Nakuru – Department of Education, ICT & eGovernment
            </p>
            <p style="margin-top:4px;">
                <a href="/"><i class="fas fa-arrow-left"></i> Back to Home</a>
            </p>
        </div>
    </div>

</body>
</html>